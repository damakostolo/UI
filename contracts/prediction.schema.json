{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hybrid policy response (not an auto UI mutation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "model_name",
    "current_layout",
    "proposed_layout",
    "probabilities",
    "confidence",
    "decision",
    "reasons",
    "requires_confirmation",
    "can_undo",
    "synthetic_mode"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,80}$"
    },
    "model_name": {
      "type": "string",
      "minLength": 2
    },
    "current_layout": {
      "enum": [
        "standard",
        "compact",
        "focus"
      ]
    },
    "proposed_layout": {
      "enum": [
        "standard",
        "compact",
        "focus"
      ]
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "compact",
        "focus"
      ],
      "properties": {
        "standard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "compact": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "enum": [
        "propose",
        "no_change"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "cold_start",
          "low_confidence",
          "low_gain",
          "cooldown",
          "active_task",
          "same_layout",
          "user_disabled",
          "model_unavailable",
          "suggestion_available",
          "accessibility_guard",
          "user_rejected"
        ]
      },
      "minItems": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "can_undo": {
      "type": "boolean"
    },
    "synthetic_mode": {
      "type": "boolean"
    }
  }
}
